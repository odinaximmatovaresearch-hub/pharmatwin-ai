/* ================= NAVIGATION ================= */

function page(name,btn){

 currentPage=name;

 document.querySelectorAll(".nav button")
   .forEach(x=>x.classList.remove("active"));

 if(btn)btn.classList.add("active");

 render();

 if(innerWidth<1000)
   document.getElementById("sidebar").classList.remove("open");

}

function render(){

 const c=document.getElementById("content");

 if(currentPage==="dashboard")c.innerHTML=dashboard();

 if(currentPage==="patients")c.innerHTML=patientPage();

 if(currentPage==="simulation")c.innerHTML=simulationPage();

 if(currentPage==="laboratory")c.innerHTML=labPage();

 if(currentPage==="medications")c.innerHTML=medicationPage();

 if(currentPage==="diseases")c.innerHTML=diseasePage();

 if(currentPage==="advanced")c.innerHTML=advancedPage();

 if(currentPage==="alerts")c.innerHTML=alertPage();

 if(currentPage==="evidence")c.innerHTML=evidencePage();

 if(currentPage==="activity")c.innerHTML=activityPage();

 if(currentPage==="settings")c.innerHTML=settingsPage();

 if(currentPage==="simulation")
   setTimeout(initChart,100);

}


