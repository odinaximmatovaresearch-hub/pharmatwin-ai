.med-info{
  color:var(--muted);
  font-size:9px;
  margin-top:4px;
}

.med-right{
  text-align:right;
}

/* TIMELINE */

.timeline{
  position:relative;
  margin-left:10px;
  padding-left:25px;
}

.timeline:before{
  content:"";
  position:absolute;
  left:5px;
  top:3px;
  bottom:3px;
  width:1px;
  background:var(--line);
}

.event{
  position:relative;
  margin-bottom:22px;
}

.event:before{
  content:"";
  position:absolute;
  left:-24px;
  top:3px;
  width:8px;
  height:8px;
  border-radius:50%;
  background:var(--brand);
}

.event-time{
  color:var(--muted);
  font-size:8px;
}

.event-title{
  font-size:11px;
  font-weight:800;
  margin-top:3px;
}

.event-text{
  color:#8298a9;
  font-size:9px;
  margin-top:4px;
  line-height:1.5;
}

/* AI */

.ai{
  background:linear-gradient(145deg,#0d2630,#0b1928);
  border-color:rgba(27,208,184,.25);
}

.ai-title{
  display:flex;
  gap:10px;
  align-items:center;
  margin-bottom:15px;
}

.ai-icon{
  width:32px;
  height:32px;
  border-radius:9px;
  background:rgba(27,208,184,.1);
  display:grid;
  place-items:center;
  color:var(--brand);
}

.ai-text{
  font-size:11px;
  color:#c3d2dc;
  line-height:1.7;
}

.ai-box{
  margin-top:13px;
  border-left:3px solid var(--brand);
  background:#081a24;
  padding:11px;
  border-radius:6px;
}

/* LABS */

.lab{
  padding:14px;
  background:#091827;
  border:1px solid var(--line);
  border-radius:9px;
}

.lab-name{
  font-size:9px;
  color:var(--muted);
}

.lab-value{
  font-size:18px;
  font-weight:850;
  margin-top:7px;
}

.lab-range{
  color:#687e91;
  font-size:8px;
  margin-top:4px;
}

/* TERMINAL */

.advanced{
  border:1px solid rgba(255,98,114,.3);
  background:linear-gradient(145deg,rgba(255,98,114,.06),#0b1928);
}

.prognosis{
  display:flex;
  align-items:center;
  gap:15px;
}

.prognosis-circle{
  width:75px;
  height:75px;
  border-radius:50%;
  border:5px solid var(--warning);
  display:grid;
  place-items:center;
  text-align:center;
  font-size:10px;
  font-weight:800;
}

/* CONSENT */

.overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.72);
  backdrop-filter:blur(6px);
  display:none;
  align-items:center;
  justify-content:center;
  z-index:100;
  padding:20px;
}

.modal{
  width:500px;
  max-width:100%;
  background:#0c1c2b;
  border:1px solid var(--line);
  border-radius:15px;
  padding:25px;
  box-shadow:0 30px 90px rgba(0,0,0,.5);
}

.modal h2{
  font-size:17px;
  margin:0 0 7px;
}

.modal p{
  color:var(--muted);
  font-size:11px;
  line-height:1.6;
}

.consent-box{
  background:#081725;
  border:1px solid var(--line);
  border-radius:9px;
  padding:14px;
  margin:18px 0;
}

.consent-row{
  display:flex;
  gap:10px;
  padding:8px 0;
  font-size:10px;
  color:#b7c9d5;
}

/* MOBILE */

.mobile{
  display:none;
}

@media(max-width:1000px){

  .sidebar{
    transform:translateX(-100%);
    transition:.25s;
  }

  .sidebar.open{
    transform:translateX(0);
  }

  .main{
    margin-left:0;
  }

  .mobile{
    display:block;
  }

  .g4{
    grid-template-columns:repeat(2,1fr);
  }

  .main-grid{
    grid-template-columns:1fr;
  }
}

@media(max-width:650px){

  .content{
    padding:16px;
  }

  .search{
    display:none;
  }

  .g2,.g3,.g4{
    grid-template-columns:1fr;
  }

  .stats{
    grid-template-columns:repeat(2,1fr);
  }

  .stat:nth-child(2),
  .stat:nth-child(4){
    border-right:0;
  }

  .page-head{
    flex-direction:column;
    gap:12px;
  }

}
</style>
</head>

