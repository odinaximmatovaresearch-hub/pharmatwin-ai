  max-width:92%;
  background:rgba(11,25,40,.95);
  border:1px solid var(--line);
  border-radius:18px;
  padding:35px;
  box-shadow:0 30px 90px rgba(0,0,0,.4);
}

.auth-logo{
  display:flex;
  gap:12px;
  align-items:center;
  margin-bottom:30px;
}

.logo-box{
  width:45px;
  height:45px;
  display:grid;
  place-items:center;
  border-radius:12px;
