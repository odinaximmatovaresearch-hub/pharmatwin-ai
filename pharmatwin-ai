function openPatient(id){

 selected=patients.find(p=>p.id===id)||patients[0];

 page("patients");

}

function openPatientByName(name){

 selected=patients.find(p=>p.name===name)||patients[0];

 page("patients");

}

function updateDose(){

 const dose=document.getElementById("dose").value;

 document.getElementById("doseText").innerText=dose+" mg";

}

function runSimulation(){

 const dose=Number(document.getElementById("dose").value);

 let risk=selected.risk;

 if(selected.egfr<45)
   risk+=7;

 if(dose>1000)
   risk+=8;

 risk=Math.min(99,risk);

 document.getElementById("score").innerText=risk;

 const after=document.getElementById("afterRisk");

 if(after)
   after.innerText=risk;

 toast("Simulation completed");

 initChart();

}

function initChart(){

 const ctx=document.getElementById("chart");

 if(!ctx)return;

 if(chart)chart.destroy();

 const multiplier=
   selected.egfr<45?1.55:
   selected.egfr<60?1.25:1;

 chart=new Chart(ctx,{

  type:"line",

  data:{

   labels:[
    "0h","2h","4h","6h","8h",
    "10h","12h","16h","20h","24h"
   ],

   datasets:[

    {
     label:"Predicted exposure",
     data:[
      0,
      12*multiplier,
      26*multiplier,
      23*multiplier,
      18*multiplier,
      14*multiplier,
      11*multiplier,
      7*multiplier,
      4*multiplier,
      2*multiplier
     ],
     borderColor:"#1bd0b8",
     backgroundColor:"rgba(27,208,184,.08)",
     fill:true,
     tension:.4
    },

    {
     label:"Reference threshold",
     data:Array(10).fill(25),
     borderColor:"#f4bd50",
     borderDash:[6,6],
     pointRadius:0
    }

   ]

  },

  options:{

   responsive:true,
   maintainAspectRatio:false,

   plugins:{
    legend:{
     labels:{
      color:"#9bb0bf",
      font:{size:9}
     }
    }
   },

   scales:{
    x:{
     ticks:{color:"#688095"},
     grid:{color:"rgba(255,255,255,.04)"}
    },

    y:{
     ticks:{color:"#688095"},
     grid:{color:"rgba(255,255,255,.04)"}
    }
   }

  }

 });

}


