  margin:auto;
}

/* COMMON */

.page-head{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  margin-bottom:22px;
}

h1{
  font-size:26px;
  margin:0;
}

.subtitle{
  color:var(--muted);
  font-size:11px;
  margin-top:6px;
}

.grid{
  display:grid;
  gap:15px;
}

.g2{grid-template-columns:repeat(2,1fr)}
.g3{grid-template-columns:repeat(3,1fr)}
.g4{grid-template-columns:repeat(4,1fr)}
.main-grid{grid-template-columns:1.7fr 1fr}

.card{
